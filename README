appium --ka 800 --use-plugins=device-farm --pa /wd/hub --plugin-device-farm-platform=android --allow-insecure=*:adb_shell

################ WEB LOCAL ################
mvn clean test "-Dgroups=one, two" "-Dplatform=web" "-Dbrowser=firefox"

################ WEB DOCKER ################
docker compose up -d
docker-compose run --rm test-run mvn clean test "-Dgroups=one, two" "-Denv=docker" "-Dplatform=web" "-Dbrowser=firefox"
docker-compose run --rm test-run mvn clean test "-Dgroups=one, two" "-Denv=docker" "-Dplatform=web" "-Dselenide.browser=firefox"
docker compose down

################ MOBILE WEB LOCAL ################
