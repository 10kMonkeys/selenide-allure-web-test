{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["page", "per_page", "total", "total_pages", "data", "support"],
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1,
      "description": "Текущая страница"
    },
    "per_page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Количество элементов на странице"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Общее количество элементов"
    },
    "total_pages": {
      "type": "integer",
      "minimum": 1,
      "description": "Общее количество страниц"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "email", "first_name", "last_name", "avatar"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "ID пользователя"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email пользователя"
          },
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Имя пользователя"
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Фамилия пользователя"
          },
          "avatar": {
            "type": "string",
            "format": "uri",
            "description": "URL аватара пользователя"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "description": "Список пользователей"
    },
    "support": {
      "type": "object",
      "required": ["url", "text"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL поддержки"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Текст поддержки"
        }
      },
      "additionalProperties": false
    },
    "_meta": {
      "type": "object",
      "required": ["powered_by", "upgrade_url", "docs_url", "template_gallery", "message", "features", "upgrade_cta"],
      "properties": {
        "powered_by": {
          "type": "string",
          "minLength": 1,
          "description": "Информация о платформе"
        },
        "upgrade_url": {
          "type": "string",
          "format": "uri",
          "description": "URL для апгрейда"
        },
        "docs_url": {
          "type": "string",
          "format": "uri",
          "description": "URL документации"
        },
        "template_gallery": {
          "type": "string",
          "format": "uri",
          "description": "URL галереи шаблонов"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Информационное сообщение"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Список возможностей"
        },
        "upgrade_cta": {
          "type": "string",
          "minLength": 1,
          "description": "Призыв к действию для апгрейда"
        }
      },
      "additionalProperties": false,
      "description": "Мета-данные API"
    }
  },
  "additionalProperties": false
}