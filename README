################ MOBILE WEB LOCAL ################
mvn clean test "-Dgroups=one, two" "-Dplatform=mobile_native" "-Denv=local" "-Dos=android" "-Ddevice=pixel_9_pro"


===================== NEW DOCKER SELENOID =======================
docker compose build --no-cache test-run  -> build via docker-compose.yaml, not directly based on dockerfile
docker compose up test-run -d

################ for ci ################
docker compose up -d
docker-compose run --rm test-run mvn clean test "-Dgroups=docker" "-Denv=docker" "-Dplatform=web" "-Dselenide.browser=chrome"


################ for local develop ################
docker compose up -d --build
docker-compose run -d test-run tail -f /dev/null
docker-compose exec test-run mvn clean test "-Dgroups=one, two, apiTests" "-Denv=docker" "-Dplatform=web" "-Dselenide.browser=firefox"

