
****** MAVEN TEST RUN CMD******

mvn clean test "-Dselenide.browser=firefox" "-Dgroups=one, two" "-Dsurefire.parallel=classes" "-Dsurefire.threadCount=2"

mvn test -Djunit.jupiter.tags=one,two

-Dselenide.browser=chrome
-Dselenide.browserVersion=120
-Dselenide.headless=true
-Dgroups=one, two

mvn test -Dsurefire.forkCount=2 -Dsurefire.parallel=classes -Dsurefire.threadCount=2
-Dsurefire.forkCount=2 // separate JVM
-Dsurefire.threadCount=2 // separate threads in one JVM with common statics, drivers etc.

****** ALLURE CMD ******

allure generate target/allure-results -o target/allure-report --clean
allure serve ./target/allure-results


# Запуск тестов + генерация + открытие отчета
mvn clean test allure:serve

# 1. Запустить тесты
mvn clean test

# 2. Сгенерировать отчет
mvn allure:report

# 3. Открыть отчет в браузере
mvn allure:serve

